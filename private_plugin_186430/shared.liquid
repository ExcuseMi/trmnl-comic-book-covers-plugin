{% template main %}

{% liquid
assign salt = view | plus:0 | times: 17
assign unique_number = "now" | date: "%s%N" | times: 1
assign unique_salted = unique_number | plus: salt
assign lc = landscape_count | default: 1
assign pc = portrait_count | default: 1
assign item_count = data.portrait_items.size
assign idx0 = unique_salted | modulo: item_count
assign idx1 = idx0 | plus: 1 | modulo: item_count
assign idx2 = idx0 | plus: 2 | modulo: item_count
assign idx3 = idx0 | plus: 3 | modulo: item_count
assign p0 = data.portrait_items[idx0]
assign p1 = data.portrait_items[idx1]
assign p2 = data.portrait_items[idx2]
assign p3 = data.portrait_items[idx3]
%}

{% if item_count == 0 %}
<div class="layout layout--stretch layout--center">
  <span class="title">API unavailable, will retry on next refresh.</span>
</div>
{% else %}

<style>
  .comic-bg { position:absolute; top:0; left:0; width:100%; height:100%; object-fit:cover; object-position:center; opacity:0.2; filter:blur(8px) brightness(1.3); z-index:0; }
  .comic-fg { position:relative; z-index:1; }
  .comic-col { flex:1; min-width:0; min-height:0; display:flex; align-items:center; justify-content:center; overflow:hidden; }
  .comic-inner { display:flex; flex-direction:column; max-height:100%; }
  .comic-inner img { flex:1; min-height:0; width:auto; max-width:100%; display:block; }
  .comic-inner .label { width:100%; }
  .comic-col--stack { align-items:stretch; }
  .comic-col--stack .comic-inner { width:100%; max-height:100%; }
  .comic-col--stack .comic-inner img { width:100%; height:auto; flex:none; max-height:100%; object-fit:contain; }
</style>
<img class="image-dither comic-bg" src="{{p0.url}}" />

{% unless force_portrait %}
<div class="layout layout--stretch layout--center comic-fg m--0 p--0 gap--medium {% unless force_landscape %}portrait:hidden{% endunless %}">
  <div class="comic-col"><div class="comic-inner"><img class="image image-dither" src="{{p0.url}}" /><div class="label lg:label--large label--inverted" data-clamp="1">{{p0.volume_name}} #{{p0.issue_number}}</div></div></div>
  {% if lc >= 2 %}<div {% if pc < 2 %}class="portrait:hidden comic-col" {% else %}class="comic-col" {% endif %}><div class="comic-inner"><div class="label lg:label--large label--inverted" data-clamp="1">{{p1.volume_name}} #{{p1.issue_number}}</div><img class="image image-dither" src="{{p1.url}}" /></div></div>{% endif %}
  {% if lc >= 3 %}<div class="portrait:hidden comic-col"><div class="comic-inner"><img class="image image-dither" src="{{p2.url}}" /><div class="label lg:label--large label--inverted" data-clamp="1">{{p2.volume_name}} #{{p2.issue_number}}</div></div></div>{% endif %}
  {% if lc >= 4 %}<div class="portrait:hidden comic-col"><div class="comic-inner"><div class="label lg:label--large label--inverted" data-clamp="1">{{p3.volume_name}} #{{p3.issue_number}}</div><img class="image image-dither" src="{{p3.url}}" /></div></div>{% endif %}
</div>
{% endunless %}

{% unless force_landscape %}
<div class="layout layout--stretch layout--center comic-fg m--0 p--0 gap--medium {% unless force_portrait %}hidden portrait:flex{% endunless %}"{% if portrait_stack %} style="flex-direction:column"{% endif %}>
  {% if portrait_stack %}
  <div class="comic-col comic-col--stack"><div class="comic-inner"><img class="image image-dither" src="{{p0.url}}" /><div class="label lg:label--large label--inverted" data-clamp="1">{{p0.volume_name}} #{{p0.issue_number}}</div></div></div>
  {% if pc >= 2 %}<div class="comic-col comic-col--stack"><div class="comic-inner"><img class="image image-dither" src="{{p1.url}}" /><div class="label lg:label--large label--inverted" data-clamp="1">{{p1.volume_name}} #{{p1.issue_number}}</div></div></div>{% endif %}
  {% else %}
  <div class="comic-col"><div class="comic-inner"><img class="image image-dither" src="{{p0.url}}" /><div class="label lg:label--large label--inverted" data-clamp="1">{{p0.volume_name}} #{{p0.issue_number}}</div></div></div>
  {% if pc >= 2 %}<div class="comic-col"><div class="comic-inner"><div class="label lg:label--large label--inverted" data-clamp="1">{{p1.volume_name}} #{{p1.issue_number}}</div><img class="image image-dither" src="{{p1.url}}" /></div></div>{% endif %}
  {% endif %}
</div>
{% endunless %}

{% endif %}
{% endtemplate %}
