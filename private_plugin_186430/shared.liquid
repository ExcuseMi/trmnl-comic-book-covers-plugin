{% template main %}

{% liquid
assign salt = view | plus:0 | times: 17
assign unique_number = "now" | date: "%s%N" | times: 1
assign unique_salted = unique_number | plus: salt
assign lc = landscape_count | default: 1
assign pc = portrait_count | default: 1
assign item_count = data.portrait_items.size
assign idx0 = unique_salted | modulo: item_count
assign idx1 = idx0 | plus: 1 | modulo: item_count
assign idx2 = idx0 | plus: 2 | modulo: item_count
assign idx3 = idx0 | plus: 3 | modulo: item_count
assign p0 = data.portrait_items[idx0]
assign p1 = data.portrait_items[idx1]
assign p2 = data.portrait_items[idx2]
assign p3 = data.portrait_items[idx3]
%}

{% if item_count == 0 %}
<div class="layout layout--stretch layout--center">
  <span class="title">API unavailable, will retry on next refresh.</span>
</div>
{% else %}

<style>
  .comic-bg { position:absolute; top:0; left:0; width:100%; height:100%; object-fit:cover; object-position:center; opacity:0.2; filter:blur(8px) brightness(1.3); z-index:0; }
  .comic-fg { position:relative; z-index:1; }
</style>
<img class="image-dither comic-bg" src="{{p0.url}}" />

{% unless force_portrait %}
<div class="layout layout--stretch layout--center comic-fg m--0 p--0 gap--s {% unless force_landscape %}portrait:hidden{% endunless %}">
  <div style="flex:1;min-width:0;overflow:hidden;position:relative"><img class="image image-dither image--cover w--full h--full" style="object-position:top" src="{{p0.url}}" /><div class="label text--xs label--inverted" style="position:absolute;bottom:0;left:0;right:0" data-clamp="1">{{p0.volume_name}} #{{p0.issue_number}}</div></div>
  {% if lc >= 2 %}<div {% if pc < 2 %}class="portrait:hidden" {% endif %}style="flex:1;min-width:0;overflow:hidden;position:relative"><img class="image image-dither image--cover w--full h--full" style="object-position:top" src="{{p1.url}}" /><div class="label text--xs label--inverted" style="position:absolute;bottom:0;left:0;right:0" data-clamp="1">{{p1.volume_name}} #{{p1.issue_number}}</div></div>{% endif %}
  {% if lc >= 3 %}<div class="portrait:hidden" style="flex:1;min-width:0;overflow:hidden;position:relative"><img class="image image-dither image--cover w--full h--full" style="object-position:top" src="{{p2.url}}" /><div class="label text--xs label--inverted" style="position:absolute;bottom:0;left:0;right:0" data-clamp="1">{{p2.volume_name}} #{{p2.issue_number}}</div></div>{% endif %}
  {% if lc >= 4 %}<div class="portrait:hidden" style="flex:1;min-width:0;overflow:hidden;position:relative"><img class="image image-dither image--cover w--full h--full" style="object-position:top" src="{{p3.url}}" /><div class="label text--xs label--inverted" style="position:absolute;bottom:0;left:0;right:0" data-clamp="1">{{p3.volume_name}} #{{p3.issue_number}}</div></div>{% endif %}
</div>
{% endunless %}

{% unless force_landscape %}
<div class="layout layout--stretch layout--center comic-fg m--0 p--0 gap--s {% unless force_portrait %}hidden portrait:flex{% endunless %}"{% if portrait_stack %} style="flex-direction:column"{% endif %}>
  <div style="flex:1;{% if portrait_stack %}min-height:0{% else %}min-width:0{% endif %};overflow:hidden;position:relative"><img class="image image-dither image--cover w--full h--full" style="object-position:top" src="{{p0.url}}" /><div class="label text--xs label--inverted" style="position:absolute;bottom:0;left:0;right:0" data-clamp="1">{{p0.volume_name}} #{{p0.issue_number}}</div></div>
  {% if pc >= 2 %}<div style="flex:1;{% if portrait_stack %}min-height:0{% else %}min-width:0{% endif %};overflow:hidden;position:relative"><img class="image image-dither image--cover w--full h--full" style="object-position:top" src="{{p1.url}}" /><div class="label text--xs label--inverted" style="position:absolute;bottom:0;left:0;right:0" data-clamp="1">{{p1.volume_name}} #{{p1.issue_number}}</div></div>{% endif %}
</div>
{% endunless %}

{% endif %}
{% endtemplate %}
